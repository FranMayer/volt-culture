# =============================================================================
# VOLT Culture — variables de entorno (Vercel + vercel dev + scripts locales)
# Copiá este archivo a .env.local y completá los valores.
# =============================================================================

# --- Firebase Admin (service account) ---
# Usado por APIs serverless, webhooks y scripts en /scripts (checkout, Firestore, auth admin).
FIREBASE_PROJECT_ID=
# Email de la service account (ej. firebase-adminsdk-...@volt-store-65157.iam.gserviceaccount.com)
FIREBASE_CLIENT_EMAIL=
# Clave privada PEM completa; en Vercel pegar con \n literales o saltos de línea reales
FIREBASE_PRIVATE_KEY=

# --- Mercado Pago ---
# Access token de producción o test para Checkout Pro y consultas de pago
MP_ACCESS_TOKEN=
# Secreto del webhook en MP → sin esto no se valida la firma de /api/webhook (recomendado en prod)
MP_WEBHOOK_SECRET=

# --- Resend (emails transaccionales) ---
# API key de Resend; bienvenida, confirmación de compra, cambios de estado de pedido
RESEND_API_KEY=

# --- Sitio público ---
# URL canónica del sitio (back_urls de MP, links en emails). Usar una sola forma: con o sin www
SITE_URL=https://voltculture.com.ar

# --- Cloudinary (panel admin — subida de imágenes de productos) ---
# Dashboard Cloudinary → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp de aviso de venta al admin, vía WAHA (opcional) ---
# Al comprador se le avisa por MAIL (Resend), no por WhatsApp. Esto es solo el aviso al admin.
# Usado por lib/server/whatsapp.js desde /api/webhook al aprobarse el pago.
# Las 4 variables van juntas: si falta cualquiera, no se manda nada (el pedido no se rompe).
#
# Destinatario. Se normaliza: acepta 5493511234567, +54 9 351..., 0351 15 123-4567.
ADMIN_WHATSAPP_NUMBER=
# Base URL de tu instancia WAHA, SIN barra final.
# OJO: /api/webhook corre en una función serverless de Vercel — un localhost NO es alcanzable
# desde ahí. En producción tiene que ser una URL pública (túnel, VPS o WAHA Cloud).
WAHA_URL=
# API key de WAHA; se manda como header X-Api-Key. Dejala vacía si tu instancia no la exige.
WAHA_API_KEY=
# Nombre de la sesión de WAHA. Ojo: si la creaste desde el dashboard sin nombrarla,
# WAHA le pone un id autogenerado (session_01kymv84...) y NO se llama "default";
# mandarle un nombre inexistente falla con 404 "Session not found".
# Verificalo con: curl -H "X-Api-Key: <key>" <WAHA_URL>/api/sessions?all=true
WAHA_SESSION=default

# --- Upstash Redis — rate limiting en /api/* ---
# Crear base en https://console.upstash.com/; si faltan, las APIs siguen sin límite por IP
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Desarrollo / CI (opcional) ---
# Base URL para tests/smoke.test.js (canónico www; el apex redirige 307)
BASE_URL=https://www.voltculture.com.ar
